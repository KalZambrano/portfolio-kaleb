---
import { Image } from "astro:assets";
import MaximizeIcon from "@/assets/icons/arrows-maximize.svg";
import { getLogoImage } from "@/lib/images";

interface Props {
  imageSrc: string;
  organization: string;
  title: string;
  href: string;
  skills: string[];
}

const { imageSrc, organization, title, href, skills } = Astro.props;

const logo = getLogoImage(imageSrc);
---

<article
  class="border bg-white dark:bg-gray-950/80 border-gray-400 dark:border-gray-700 rounded-2xl p-4 hover:scale-105 transition-all flex flex-col justify-between"
>
  <div class="flex items-center gap-4 mb-3">
    <Image
      class="w-16 h-fit rounded-xl"
      src={logo}
      alt={`${organization} logo`}
      width={128}
      loading="lazy"
      decoding="async"
    />
    <span>
      <h2 class="font-bold text-xl line-clamp-2" title={title}>{title}</h2>
      <h3 class="text-green-700 dark:text-green-400">{organization}</h3>
    </span>
  </div>
  <div class="flex justify-between items-center gap-x-2">
    <div
      class="flex gap-3 w-56 truncate overflow-hidden"
      style="mask-image: linear-gradient(to right, black 90%, transparent);"
    >
      {
        skills.map((skill) => (
          <span
            class="rounded-full px-3 py-1 text-xs text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800 transition-colors ease-in-out"
            title={skill}
          >
            {skill}
          </span>
        ))
      }
    </div>
    <a
      class="flex gap-x-1 items-center text-cyan-700 dark:text-cyan-500"
      href={`/documents/${href}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Open certificate ${title} from ${organization}`}
    >
      View
      <MaximizeIcon class="size-5" />
    </a>
  </div>
</article>
