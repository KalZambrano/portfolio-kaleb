---
import ThemeToogle from "@/components/ThemeToogle.astro";
import LanguajeSelector from "./LanguajeSelector.astro";
import HeaderLink from "./HeaderLink.astro";
import MenuIcon from "@/assets/icons/menu-2.svg";
import CloseIcon from "@/assets/icons/x.svg";

// import { getI18N } from "@/i18n/index";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

// const { currentLocale } = Astro;
// const i18n = getI18N({ currentLocale });

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const navItems = [
  {
    href: translatePath("/#experiencia"),
    label: "experiencia",
    text: t("nav.experiencia"),
  },
  {
    href: translatePath("/#proyectos"),
    label: "proyectos",
    text: t("nav.proyectos"),
  },
  {
    href: translatePath("/#certificados"),
    label: "certificados",
    text: t("nav.certificados"),
  },
  {
    href: translatePath("/#habilidades"),
    label: "habilidades",
    text: t("nav.habilidades"),
  },
  {
    href: translatePath("/#sobremi"),
    label: "sobremi",
    text: t("nav.sobremi"),
  },
];
---

<header
  id="header-nav"
  class="fixed top-0 left-1/2 -translate-x-1/2 w-full xl:w-3/4 px-6 py-4 z-20"
>
  <div
    class="max-w-7xl mx-auto flex items-center justify-end xl:justify-center"
  >
    <nav
      id="header-menu"
      aria-label="Main navigation"
      class="fixed w-full h-dvh inset-0 bg-[#ABD5FF]/90 dark:bg-[#152636]/90 xl:rounded-full xl:text-xl lg:text-xl flex flex-col items-center justify-center gap-14 xl:gap-8 -translate-y-full transition-transform duration-300 target:translate-y-0 xl:static xl:h-auto xl:bg-white/50 xl:dark:bg-gray-800/50 xl:flex-row xl:translate-y-[initial] xl:w-auto xl:px-6 xl:py-1.5 xl:border-gray-200 xl:dark:border-gray-600 xl:border-2"
    >
      {
        navItems.map((item) => (
          <HeaderLink href={item.href} label={item.label}>
            {item.text}
          </HeaderLink>
        ))
      }
      <LanguajeSelector />
      <ThemeToogle />
      <a
        href="#header-nav"
        class="xl:hidden absolute top-6 right-6 text-black dark:text-white"
        aria-label="Close button"
        rel="noopener noreferrer"
      >
        <CloseIcon class="size-6" />
      </a>
    </nav>
    <a
      href="#header-menu"
      class="xl:hidden text-black dark:text-white"
      aria-label="Burger menu button"
      rel="noopener noreferrer"
    >
      <MenuIcon class="size-6" />
    </a>
  </div>
</header>

<style>
  @media (width >= 80rem) {
    nav {
      animation: nav-shadown 1s linear both;
      animation-timeline: scroll();
      animation-range: 0 100px;
    }
  }

  @keyframes nav-shadown {
    0% {
      background-color: transparent;
      border-color: transparent;
    }
    100% {
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      backdrop-filter: blur(10px);
    }
  }
</style>
