---
import { EMAIL } from "@/const/social";

import { getI18N } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const mailto = `mailto:${EMAIL}?subject=${encodeURIComponent(
  i18n.CONTACT.MAIL_SUBJECT
)}`;

const lines = i18n.CONTACT.HEADLINE_LINES as string[];
const accent = i18n.CONTACT.HEADLINE_ACCENT as string;
// La palabra resaltada se inyecta al final de la tercera línea
const ACCENT_LINE = 2;
---

<section
  id="contacto"
  class="cta-section relative left-1/2 -ml-[50vw] w-screen max-w-none overflow-hidden border-y border-cyan-200/80 bg-gradient-to-br from-cyan-100 via-sky-50 to-violet-100 py-10 text-center dark:border-white/10 dark:from-neutral-950 dark:via-slate-950 dark:to-cyan-950 md:py-18"
>
  <div class="relative z-10 mx-auto max-w-6xl px-6 md:px-10 lg:px-16">
    <h2
      class="mx-auto max-w-5xl text-[clamp(1.2rem,6vw,5rem)] font-extrabold uppercase leading-[0.92] tracking-tight text-neutral-950 dark:text-neutral-100"
    >
      {
        lines.map((line, index) => (
          <span class="block">
            {line}
            {index === ACCENT_LINE && (
              <span class="cta-accent text-cyan-500 dark:text-cyan-400">{accent}</span>
            )}
          </span>
        ))
      }
    </h2>

    <p class="mx-auto mt-8 max-w-xl text-base text-neutral-600 dark:text-neutral-400 md:text-lg">
      {i18n.CONTACT.SUBTITLE}
    </p>

    <a
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-cyan-500 px-6 py-3 font-semibold text-neutral-950 transition-transform hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-600 dark:bg-cyan-300 dark:focus-visible:outline-cyan-300"
      href={mailto}
      aria-label={`${i18n.CONTACT.BUTTON} — ${EMAIL}`}
    >
      {i18n.CONTACT.BUTTON}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  :global(html),
  :global(body) {
    overflow-x: hidden;
  }

  /* Misma tipografía que el resto del titular, solo cambia el resalte */
  .cta-accent {
    text-shadow:
      0 0 10px oklch(80% 0.12 221.7 / 0.55),
      0 0 22px oklch(70% 0.13 221.7 / 0.35);
  }

  :global(.dark) .cta-accent {
    text-shadow:
      0 0 10px oklch(85% 0.14 211.5 / 0.75),
      0 0 24px oklch(78% 0.15 211.5 / 0.5);
  }
</style>
