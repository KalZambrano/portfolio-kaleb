---
interface Props {
  href: string;
  label: string;
  section?: string;
}

const { href, label, section } = Astro.props;
---

<a
  class="text-base relative block px-3 py-1 transition hover:text-cyan-500 dark:hover:text-cyan-400 text-black dark:text-white
  rounded-full
    aria-[current=location]:text-cyan-700 dark:aria-[current=location]:text-cyan-500
    aria-[current=location]:bg-cyan-700/10 dark:aria-[current=location]:bg-cyan-500/10
    "
  href={href}
  aria-label={label}
  data-nav-link={section}
>
  <slot />
</a>

<style>
  @media (width >= 80rem) {
    a {
      animation: text-shadown 1s linear both;
      animation-timeline: scroll();
      animation-range: 0 100px;
    }
  }

  @keyframes text-shadown {
    0% {
      text-shadow: transparent;
    }
    100% {
      text-shadow: 1px 1px 15px #ffffffb9;
    }
  }
</style>
