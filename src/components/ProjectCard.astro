---
import { Picture } from "astro:assets";
import RedirectIcon from "@/assets/icons/external-link.svg";
import GitHub from "@/assets/social/github.svg";
import { getProjectImage } from "@/lib/images";

interface Props {
  image: string;
  title: string;
  description: string;
  github?: string;
  url: string;
  tecs: Tec[];
}

type Tec =
  "Laravel" | "Astro" | "JS" | "Tailwind" | "React" | "TS" | "Supabase" | "CloudFlare";

const LANGUAJE_DICTIONARY: Record<
  Tec,
  { color: string; src: string; srcDark?: string; alt: string }
> = {
  Laravel: {
    color: "bg-red-600/15",
    src: "/icons/laravel.svg",
    alt: "Laravel Icon",
  },
  Astro: {
    color: "bg-orange-600/15 text-black",
    src: "/icons/astro.svg",
    srcDark: "/icons/dark/astro_dark.svg",
    alt: "Astro Icon",
  },
  JS: {
    color: "bg-yellow-600/15",
    src: "/icons/javascript.svg",
    alt: "JavaScript Icon",
  },
  Tailwind: {
    color: "bg-cyan-600/15",
    src: "/icons/tailwindcss.svg",
    alt: "Tailwind Icon",
  },
  React: {
    color: "bg-sky-600/15",
    src: "/icons/dark/react_dark.svg",
    srcDark: "/icons/react_light.svg",
    alt: "React Icon",
  },
  TS: {
    color: "bg-blue-600/15",
    src: "/icons/typescript.svg",
    alt: "TypeScript Icon",
  },
  Supabase: {
    color: "bg-green-600/15",
    src: "/icons/supabase.svg",
    alt: "Supabase Icon",
  },
  CloudFlare: {
    color: "bg-amber-600/15",
    src: "/icons/cloudflare.svg",
    alt: "CloudFlare Icon",
  }
};

const generateTecIconHTML = (tec: Tec): string => {
  const { color, src, srcDark, alt } = LANGUAJE_DICTIONARY[tec];

  if (srcDark) {
    // Si hay icono específico para modo oscuro, genera dos imágenes
    return `
    <img class="size-9 ${color} p-1.5 rounded-md dark:block hidden" src="${srcDark}" alt="${alt}" loading="lazy" decoding="async">
    <img class="size-9 ${color} p-1.5 rounded-md dark:hidden block" src="${src}" alt="${alt}" loading="lazy" decoding="async">
    `;
  } else {
    // Si no hay icono específico, genera solo una imagen
    return `
    <img class="size-9 ${color} p-1.5 rounded-md" src="${src}" alt="${alt}" loading="lazy" decoding="async">
    `;
  }
};

const { image, title, description, github, url, tecs } = Astro.props;

const projectImage = getProjectImage(image);
---

<article
  class="border bg-white dark:bg-gray-950/80 border-gray-400 dark:border-gray-700 rounded-2xl w-full group transition-colors ease-in-out"
>
  <div
    class="rounded-t-2xl"
    style="mask-image: linear-gradient(black 70%, transparent);"
  >
    <Picture
      class="w-full group-hover:scale-105 ease-in-out transition-all duration-400"
      src={projectImage}
      alt={`Imagen de presentación del proyecto de ${title}`}
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[400, 800, 1200]}
      sizes="(min-width: 1024px) 360px, (min-width: 768px) 45vw, calc(100vw - 2.5rem)"
      pictureAttributes={{ class: "block" }}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="flex flex-col justify-between p-5 h-52">
    <div class="mb-4">
      <h2 class="text-2xl font-bold mb-2 truncate" title={title}>{title}</h2>
      <p class="dark:text-gray-400 line-clamp-3">{description}</p>
    </div>
    <div class="flex justify-between">
      <ul class="flex gap-2">
        {
          tecs.map((tec: Tec) => {
            return <li set:html={generateTecIconHTML(tec)} />;
          })
        }
      </ul>
      <ul class="flex gap-2">
        {
          github ? (
            <li>
              <a
                target="_blank"
                href={github}
                aria-label={`${title} Github Repo`}
                rel="noopener noreferrer"
              >
                <GitHub class="size-9 bg-gray-600/15 hover:bg-gray-600/40 p-1.5 rounded-md transition-colors" />
              </a>
            </li>
          ) : null
        }
        <li>
          <a
            target="_blank"
            href={url}
            aria-label={`${title} Preview`}
            rel="noopener noreferrer"
          >
            <RedirectIcon
              class="size-9 bg-gray-600/15 hover:bg-gray-600/40 p-1.5 rounded-md transition-colors"
            />
          </a>
        </li>
      </ul>
    </div>
  </div>
</article>
