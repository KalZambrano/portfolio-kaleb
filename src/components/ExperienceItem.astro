---
interface Props {
  title: string;
  company: string;
  description: string;
  date: string;
  current?: boolean;
}

const { title, company, description, date, current = false } = Astro.props;
---

<div
  class="relative mx-12 pb-8 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-black/20 dark:before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4]"
>
  <div class="relative pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span
        class="absolute -left-[42px] flex size-[14px] items-center justify-center"
        aria-hidden="true"
      >
        {
          current && (
            <span class="animate-ping motion-reduce:animate-none absolute inline-flex size-full rounded-full bg-cyan-400/40" />
          )
        }
        <span
          class={`relative inline-flex size-[10px] rounded-full bg-cyan-400 ${current ? "shadow-[0_0_8px_2px_rgba(0,255,255,0.45)]" : ""}`}
        ></span>
      </span>
      <h3 class="text-xl font-bold text-cyan-400">{title}</h3>
      <h4 class="font-semibold text-xl text-gray-600 dark:text-white">
        {company}
      </h4>
      <time class="p-0 m-0 text-sm text-gray-600/80 dark:text-white/80"
        >{date}</time
      >
    </div>
  </div>
  <div
    class="relative flex flex-col gap-2 pb-4 text-gray-600 dark:text-gray-300 md:col-span-3"
  >
    {description}
  </div>
</div>
