---
import { SOCIAL } from "@/const/social";

import Badge from "@/components/Badge.astro";
import SocialPill from "./SocialPill.astro";
import TextType from "y/TextType/TextType";
import BlurText from "y/BlurText/BlurText";
import AboutText from "@/components/AboutText";

import { getI18N } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<section class="flex flex-col md:flex-row pt-36 mx-8">
  <aside class="mt-12 md:mt-2 md:mr-20 order-2 md:order-1">
    <ul class="flex md:flex-col flex-row gap-2 md:gap-8 justify-center">
      {
        SOCIAL.map(({ name, url, image, label, animateClass }) => (
          <SocialPill image={image} name={name} url={url} label={label} animateClass={animateClass} />
        ))
      }
    </ul>
    <hr
      class="h-0 md:h-[60px] w-[2px] mt-12 border-t-0 dark:bg-neutral-400 bg-neutral-500 mx-auto rounded-full animate-fade-in animate-delay-1000"
    />
  </aside>
  <article class="order-1 md:order-2">
    <div class="flex gap-4 mb-8 items-center animate-fade-in-up animate-delay-400">
      <div class="relative flex-shrink-0">
        <div
          class="absolute inset-0 rounded-full bg-cyan-400/30 dark:bg-cyan-400/20 blur-xl scale-125"
          aria-hidden="true"
        >
        </div>
        <img
          class="relative rounded-full shadow-2xl size-16 ring-2 ring-cyan-400/60 ring-offset-2 ring-offset-gray-50 dark:ring-offset-gray-950"
          src="/profile.webp"
          alt="Kaleb Zambrano"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <a
        target="_blank"
        rel="noopener noreferrer"
        href="https://linkedin.com/in/kaleb-zambrano-berlanga/"
        ><Badge>{i18n.HERO_BUTTON}</Badge>
      </a>
    </div>
    <BlurText
      client:idle
      text={i18n.HERO_PRESENTATION}
      delay={50}
      animateBy="words"
      direction="bottom"
      className="text-3xl md:text-5xl font-bold mb-2"
    />
    <TextType
      client:idle
      colorText="text-cyan-500 dark:text-cyan-400"
      className="text-cyan-500 dark:text-cyan-400 font-semibold text-xl md:text-3xl mb-8"
      text={[i18n.HERO_JOB]}
      typingSpeed={75}
      showCursor={true}
      cursorCharacter="|"
    />
    <AboutText client:idle>
      {
        currentLocale === "es" ? (
          <>
            <strong class="text-cyan-500 dark:text-cyan-200">
              +2 años de experiencia
            </strong>
            . Estudiante de Ingeniería de Sistemas e Informática de Lima, Perú
            🇵🇪. Especializado en{" "}
            <strong class="text-cyan-500 dark:text-cyan-200">
              desarrollo frontend
            </strong>{" "}
            y apasionado por crear aplicaciones web{" "}
            <strong class="text-cyan-500 dark:text-cyan-200">
              únicas, modernas
            </strong>{" "}
            y con interfaces{" "}
            <strong class="text-cyan-500 dark:text-cyan-200">
              fáciles de usar
            </strong>
            .
          </>
        ) : (
          <>
            <strong class="text-cyan-500 dark:text-cyan-200">
              +2 year of experience
            </strong>
            . Systems and Computer Engineering student from Lima, Peru 🇵🇪.
            Specialized in{" "}
            <strong class="text-cyan-500 dark:text-cyan-200">
              frontend development
            </strong>{" "}
            and passionate about creating{" "}
            <strong class="text-cyan-500 dark:text-cyan-200">
              unique, modern
            </strong>{" "}
            web applications with{" "}
            <strong class="text-cyan-500 dark:text-cyan-200">
              user-friendly
            </strong>{" "}
            interfaces.
          </>
        )
      }
    </AboutText>
  </article>
</section>
